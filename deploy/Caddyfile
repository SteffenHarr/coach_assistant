# Caddyfile — TLS termination, security headers, reverse proxy.
#
# - In production: set DOMAIN to your domain and TLS_EMAIL to your address;
#   Caddy will automatically obtain Let's Encrypt certificates.
# - For DOMAIN=localhost, Caddy uses an internal CA (self-signed) — fine for dev.

{
	email {$TLS_EMAIL}
	# Disable admin endpoint for safety
	admin off
}

{$DOMAIN} {
	encode gzip zstd

	# Security headers (defence-in-depth; the API also sets these)
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
		# Hide server info
		-Server
	}

	# API — strip /api prefix when forwarding.
	# The API sets its own CSP (relaxed for /docs), so we suppress Caddy's.
	handle_path /api/* {
		header -Content-Security-Policy
		reverse_proxy api:8000
	}

	# Static SPA — proxy to the web container which serves the built assets
	handle {
		reverse_proxy web:80
	}

	# Basic request size limit (defence against accidental huge uploads)
	request_body {
		max_size 1MB
	}

	log {
		output stdout
		format json
		# Do not log Authorization header
		level INFO
	}
}
