# ====== Coach Assistant – Environment Template ======
# Kopiere diese Datei nach `.env` und ersetze ALLE Default-Werte.
# Niemals diese Datei mit echten Secrets committen.

# --- API ---
API_ENV=development                 # development | production
API_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
API_JWT_ACCESS_TTL_SECONDS=43200    # 12 Std.
API_JWT_REFRESH_TTL_SECONDS=1209600 # 14 Tage
API_CORS_ORIGINS=https://localhost
API_RATE_LIMIT_PER_MINUTE=60

# --- Database ---
POSTGRES_USER=coach
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=coach_assistant
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://coach:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/coach_assistant

# --- Redis / Queue ---
REDIS_URL=redis://redis:6379/0

# --- Solver ---
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_NUM_SOLUTIONS=3              # Anzahl Plan-Varianten

# --- Web (Frontend) ---
VITE_API_BASE_URL=/api

# --- Caddy (Reverse-Proxy) ---
DOMAIN=localhost                    # In Produktion: deine Domain, z.B. app.dein-verein.de
TLS_EMAIL=internal                  # ungenutzt, solange Caddy "tls internal" nutzt

# --- Cloudflare Tunnel (named tunnel, siehe docs/SETUP.md Schritt 7 Variante A) ---
# Nur nötig, wenn du einen dauerhaften Cloudflare Tunnel mit eigener Domain
# einrichtest. Token kommt aus dem Cloudflare-Dashboard (Zero Trust -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backup-Verschlüsselung ---
# Passwort zum Ver-/Entschlüsseln der täglichen Backups (siehe Schritt 10 in
# docs/SETUP.md). Mit PowerShell generieren:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# WICHTIG: Sicher aufbewahren (z. B. Passwort-Manager) — ohne dieses Passwort
# sind die Backups im Ernstfall nicht wiederherstellbar!
BACKUP_ENCRYPTION_PASSWORD=
