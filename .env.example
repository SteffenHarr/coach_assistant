# ====== Coach Assistant – Environment Template ======
# Kopiere diese Datei nach `.env` und ersetze ALLE Default-Werte.
# Niemals diese Datei mit echten Secrets committen.

# --- API ---
API_ENV=development                 # development | production
API_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
API_JWT_ACCESS_TTL_SECONDS=900      # 15 min
API_JWT_REFRESH_TTL_SECONDS=1209600 # 14 Tage
API_CORS_ORIGINS=https://localhost
API_RATE_LIMIT_PER_MINUTE=60

# --- Database ---
POSTGRES_USER=coach
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=coach_assistant
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://coach:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/coach_assistant

# --- Redis / Queue ---
REDIS_URL=redis://redis:6379/0

# --- LLM (Ollama, lokal) ---
OLLAMA_BASE_URL=http://ollama:11434
# 3B model = schnell genug für CPU. Alternativen:
#   llama3.2:1b-instruct-q4_K_M    (sehr schnell, kürzere Antworten)
#   llama3.1:8b-instruct-q4_K_M    (klüger, deutlich langsamer auf CPU)
#   qwen2.5:3b-instruct-q4_K_M     (oft besser für Deutsch)
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
AGENT_MAX_TOOL_CALLS=10
AGENT_REQUIRE_CONFIRMATION=true     # Schreibende Tools nur mit User-Bestätigung

# --- Solver ---
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_NUM_SOLUTIONS=3              # Anzahl Plan-Varianten

# --- Web (Frontend) ---
VITE_API_BASE_URL=/api

# --- Caddy (Reverse-Proxy) ---
DOMAIN=localhost                    # In Produktion: deine Domain
TLS_EMAIL=internal                  # In Produktion: deine E-Mail für Let's Encrypt
